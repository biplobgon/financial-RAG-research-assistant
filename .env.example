# ==============================================================================
# Financial RAG Research Assistant — Environment Variables
# Copy to .env and fill in your values
# ==============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# LLM Provider: openai | vertex_ai | vllm | mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Vertex AI (optional)
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# OpenTelemetry
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=financial-rag-api

# Evaluation
HALLUCINATION_THRESHOLD=0.85
EVALUATION_ENABLED=true

# Security (comma-separated API keys for production)
API_KEYS=your-api-key-1,your-api-key-2

# LangSmith (optional)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=financial-rag
